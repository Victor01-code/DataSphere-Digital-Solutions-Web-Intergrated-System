    <style>
        .team-grid-modern {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: var(--space-xl);
            margin-top: var(--space-2xl);
        }

        .team-card-premium {
            perspective: 1000px;
        }

        .team-card-inner {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: var(--radius-2xl);
            padding: var(--space-xl);
            text-align: center;
            transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1), border-color 0.3s ease, box-shadow 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .team-card-premium:hover .team-card-inner {
            transform: translateY(-15px);
            border-color: rgba(0, 102, 255, 0.3);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
        }

        .team-image-box {
            position: relative;
            width: 120px;
            height: 120px;
            margin: 0 auto var(--space-xl);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 2;
        }

        .team-avatar-premium {
            width: 100px;
            height: 100px;
            background: var(--dark-700);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            color: var(--primary-blue-light);
            border: 2px solid rgba(255, 255, 255, 0.1);
            position: relative;
            z-index: 3;
        }

        .team-glow-bg {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 130px;
            height: 130px;
            background: var(--gradient-glow);
            border-radius: 50%;
            opacity: 0.15;
            z-index: 1;
            transition: opacity 0.3s ease, transform 0.3s ease;
        }

        .team-card-premium:hover .team-glow-bg {
            opacity: 0.4;
            transform: translate(-50%, -50%) scale(1.2);
        }

        .team-badge {
            display: inline-block;
            padding: 4px 12px;
            background: rgba(0, 102, 255, 0.1);
            color: var(--primary-blue-light);
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: var(--space-md);
        }

        .team-info-premium h4 {
            font-size: 1.25rem;
            margin-bottom: 4px;
            color: var(--white);
        }

        .team-info-premium p {
            color: var(--gray-400);
            font-size: 0.9rem;
            margin-bottom: var(--space-lg);
        }

        .team-social-premium {
            display: flex;
            justify-content: center;
            gap: var(--space-md);
        }

        .team-social-premium a {
            width: 36px;
            height: 36px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--gray-300);
            transition: background 0.3s ease, color 0.3s ease;
        }

        .team-social-premium a:hover {
            background: var(--primary-blue);
            color: var(--white);
        }

        @media (max-width: 1024px) {
            .team-grid-modern {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 640px) {
            .team-grid-modern {
                grid-template-columns: 1fr;
            }
        }
    </style>

