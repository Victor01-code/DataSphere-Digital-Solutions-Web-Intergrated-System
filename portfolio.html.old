            <style>
                .portfolio-grid-premium {
                    display: grid;
                    grid-template-columns: repeat(3, 1fr);
                    gap: var(--space-xl);
                    margin-top: var(--space-2xl);
                }

                .portfolio-card-premium {
                    position: relative;
                    border-radius: var(--radius-2xl);
                    overflow: hidden;
                    aspect-ratio: 4/3;
                    background: var(--dark-700);
                }

                .portfolio-visual-premium {
                    width: 100%;
                    height: 100%;
                    position: relative;
                }

                .portfolio-visual-premium img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
                }

                .portfolio-overlay-premium {
                    position: absolute;
                    inset: 0;
                    background: linear-gradient(to top, rgba(10, 14, 23, 0.95) 10%, rgba(10, 14, 23, 0.4));
                    display: flex;
                    align-items: flex-end;
                    padding: var(--space-xl);
                    opacity: 0;
                    transition: opacity 0.4s ease;
                }

                .portfolio-card-premium:hover .portfolio-overlay-premium {
                    opacity: 1;
                }

                .portfolio-card-premium:hover img {
                    transform: scale(1.1);
                }

                .overlay-content {
                    transform: translateY(20px);
                    transition: transform 0.4s ease;
                }

                .portfolio-card-premium:hover .overlay-content {
                    transform: translateY(0);
                }

                .overlay-category {
                    display: inline-block;
                    padding: 4px 10px;
                    background: var(--primary-blue);
                    color: white;
                    border-radius: 4px;
                    font-size: 0.7rem;
                    font-weight: 700;
                    text-transform: uppercase;
                    margin-bottom: var(--space-sm);
                }

                .overlay-content h4 {
                    font-size: 1.25rem;
                    margin-bottom: 4px;
                    color: white;
                }

                .overlay-content p {
                    font-size: 0.85rem;
                    color: var(--gray-400);
                    margin-bottom: var(--space-md);
                }

                @media (max-width: 1024px) {
                    .portfolio-grid-premium {
                        grid-template-columns: repeat(2, 1fr);
                    }
                }

                @media (max-width: 640px) {
                    .portfolio-grid-premium {
                        grid-template-columns: 1fr;
                    }
                }
            </style>
        </div>
